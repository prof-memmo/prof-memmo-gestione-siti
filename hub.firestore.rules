rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ==============================================================
    // HELPER FUNCTIONS
    // ==============================================================
    
    // Verifica se l'utente autenticato è Amministratore (Admin)
    function isAdmin() {
      // TODO: Il controllo tramite email è un fallback temporaneo per non rompere 
      // l'attuale accesso. Verrà rimosso quando il ruolo admin sarà completamente centralizzato.
      let isEmailAdmin = request.auth != null && request.auth.token.email == 'prof.memmo@gmail.com';
      let isRoleAdmin = request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ruolo == 'admin';
      return isEmailAdmin || isRoleAdmin;
    }
    
    // Verifica se l'utente sta agendo sul proprio documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Verifica che l'utente non stia tentando di auto-assegnarsi privilegi
    function noPrivilegeEscalation() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !affectedKeys.hasAny(['ruolo', 'statoAccount', 'adminOverrides']);
    }

    // Valida la creazione iniziale di un profilo
    function isValidNewUser() {
      let data = request.resource.data;
      let isAllowedRole = data.ruolo in ['studente', 'docente', 'amico_del_prof'];
      
      // Controllo di coerenza iniziale
      let isValidTeacher = (data.ruolo == 'docente' && data.statoAccount == 'pending');
      let isValidNormalUser = (data.ruolo != 'docente' && data.statoAccount == 'active');
      
      // Assicura che non si nasca con adminOverrides alterati
      let hasNoPrivilegedOverrides = data.adminOverrides.override == false 
                                  && data.adminOverrides.permessiSpeciali.size() == 0;
                                  
      return isAllowedRole && (isValidTeacher || isValidNormalUser) && hasNoPrivilegedOverrides;
    }

    // ==============================================================
    // PROFILI UTENTE CENTRALI (L'identità dell'Ecosistema)
    // ==============================================================
    match /users/{userId} {
      
      // Lettura: 
      // L'owner può leggere solo sé stesso. L'Admin può leggere tutti.
      // TODO (Fase 3B): Predisposizione per consentire ai backend dei giochi 
      // di accedere al profilo centrale per verificare ruolo e stato.
      allow read: if isOwner(userId) || isAdmin();
      
      // Creazione: 
      // L'utente loggato inizializza il suo profilo (passando la validazione)
      allow create: if isOwner(userId) && isValidNewUser();
      
      // Aggiornamento: 
      // L'admin modifica qualsiasi cosa. L'owner aggiorna solo dati non critici.
      allow update: if isAdmin() || (isOwner(userId) && noPrivilegeEscalation());
      
      // Eliminazione: 
      // Operazione distruttiva riservata solo agli Amministratori.
      allow delete: if isAdmin();
    }
    
    // ==============================================================
    // STRUMENTI E IMPOSTAZIONI HUB (Esclusivi per l'Amministratore)
    // ==============================================================
    match /hub_settings/{docId} {
      allow read, write: if isAdmin();
    }
    
    match /hub_newsletters/{docId} {
      allow read, write: if isAdmin();
    }
    
    match /hub_posta_inviata/{docId} {
      allow read, write: if isAdmin();
    }
    
    match /hub_esperienze/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
